# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Channel username (e.g. @my_channel) or chat ID
TELEGRAM_CHAT_ID=""

# TELEGRAM_API_ID: Optional Telegram API application ID
TELEGRAM_API_ID=""

# TELEGRAM_API_HASH: Optional Telegram API application hash
TELEGRAM_API_HASH=""

# TELEGRAM_THREAD_ID: Optional Telegram topic thread ID
TELEGRAM_THREAD_ID=""

# AUTO_UPLOAD_TELEGRAM: Automatically forward completed MP4 downloads to Telegram
AUTO_UPLOAD_TELEGRAM="true"
