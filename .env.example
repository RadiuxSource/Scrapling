# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Legacy deployment-wide Telegram values are not inherited by browser workspaces.
# Configure Telegram credentials separately in each browser's Telegram Hub.
# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Channel username (e.g. @my_channel) or chat ID
TELEGRAM_CHAT_ID=""

# TELEGRAM_API_ID: Optional Telegram API application ID
TELEGRAM_API_ID=""

# TELEGRAM_API_HASH: Optional Telegram API application hash
TELEGRAM_API_HASH=""

# TELEGRAM_THREAD_ID: Optional Telegram topic thread ID
TELEGRAM_THREAD_ID=""

# AUTO_UPLOAD_TELEGRAM: Automatically forward completed MP4 downloads to Telegram
AUTO_UPLOAD_TELEGRAM="true"

# Per-browser workspace identity. Keep this stable across deployments/restarts.
# Use a long random value (at least 32 bytes); do not expose it to the browser.
WORKSPACE_SECRET="replace-with-a-long-random-secret"

# Optional one-time token for POST /api/workspace/claim-legacy.
# Set it only while migrating the old shared downloads/settings/queue.
WORKSPACE_MIGRATION_TOKEN=""

# Required for durable queue recovery across Koyeb instance replacement.
# Use the Supabase Project URL (https://<project-ref>.supabase.co), not Dashboard URL.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Owner monitoring and Telegram operational log group (11/11/2026).
# OWNER_ACCESS_SECRET: Long random secret used only for the protected owner dashboard login.
OWNER_ACCESS_SECRET=""
# OWNER_TELEGRAM_USER_ID: Your numeric Telegram user ID; only this account can run owner bot commands.
OWNER_TELEGRAM_USER_ID=""
# LOG_TELEGRAM_CHAT_ID: Private Telegram group/channel ID for operational logs.
LOG_TELEGRAM_CHAT_ID=""
# LOG_TELEGRAM_BOT_TOKEN: Dedicated monitoring bot token. If blank, TELEGRAM_BOT_TOKEN is used.
LOG_TELEGRAM_BOT_TOKEN=""

# Optional: post operational logs inside one existing Telegram forum topic.
# If blank, the monitoring bot attempts to create a "Vortex Operational Logs" topic
# in LOG_TELEGRAM_CHAT_ID when that group has topics enabled and the bot can manage topics.
LOG_TELEGRAM_THREAD_ID=""
